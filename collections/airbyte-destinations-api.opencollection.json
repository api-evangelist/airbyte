              },
              {
                "name": "includeDeleted",
                "value": "",
                "type": "query",
                "description": "Include deleted destinations in the returned results."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Set the limit on the number of destinations returned. The default is 20."
              },
              {
                "name": "offset",
                "value": "",
